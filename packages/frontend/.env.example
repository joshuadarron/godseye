# WebSocket URL for the API service
VITE_WS_URL=ws://localhost:8080/ws

# Auth service URL
VITE_AUTH_URL=http://localhost:8081

# REST API base URL. Optional: when unset, the HTTP base is derived from VITE_WS_URL.
VITE_API_URL=

# Cesium Ion. Optional: free, register at https://ion.cesium.com/
VITE_CESIUM_ION_TOKEN=

# Google Map Tiles API. Optional: https://developers.google.com/maps/documentation/tile/get-api-key
VITE_GOOGLE_MAPS_API_KEY=
